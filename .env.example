# Copy to .env and fill in. Everything marked (required) must be set.

# ── Identity ────────────────────────────────────────────────────────────────
# (required) Public hostname you'll serve Feedbin from via Cloudflare Tunnel.
# No scheme, no trailing slash.
FEEDBIN_HOST=feedbin.example.com

# Optional second hostname for API clients (see README's Cloudflare Tunnel
# table - api.feedbin.example.com is an optional public hostname pointed at
# the same web:8080 service). Rails' HostAuthorization middleware
# (config.hosts, config/environments/production.rb) only allows the exact
# host(s) named in FEEDBIN_HOST, so without this, requests with an
# api.feedbin.example.com Host header are blocked with "Blocked hosts:
# api.feedbin.example.com" even though the tunnel routes them correctly.
# No scheme, no trailing slash. Leave unset if you don't need a separate API
# hostname - clients can use FEEDBIN_HOST directly.
FEEDBIN_API_HOST=

# If you set FEEDBIN_API_HOST, you almost certainly also need this. Feedbin's
# /v2/* API routes are gated behind `constraints subdomain: "api"` in its
# routes.rb, and Rails computes "subdomain" by stripping the last
# (TLD_LENGTH + 1) labels off the Host header as the "domain" - everything
# before that is the subdomain. Feedbin assumes a 2-label root domain (its
# own feedbin.com, TLD_LENGTH defaults to 1: domain=feedbin.com), but
# FEEDBIN_HOST above is itself a subdomain of your real domain
# (feedbin.example.com, 3 labels), so with the default TLD_LENGTH=1, Rails
# computes the subdomain of api.feedbin.example.com as "api.feedbin", not
# "api" - the constraint never matches and every /v2/* request 404s
# (ActionController::RoutingError in `web` logs) even though HostAuthorization
# already let it through. Setting TLD_LENGTH=2 makes Rails treat
# feedbin.example.com (3 labels) as the base domain, so "api" alone is left
# as the subdomain. Only needed if FEEDBIN_HOST has more than 2 labels.
TLD_LENGTH=

# ── Secrets ─────────────────────────────────────────────────────────────────
# (required) Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# (required) Postgres password for the "feedbin" database user.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# (required) MinIO (S3-compatible storage) credentials.
MINIO_ROOT_USER=feedbin
# Generate with: openssl rand -hex 24
MINIO_ROOT_PASSWORD=

# Public endpoint for MinIO, required for entry images/favicons to actually
# load in a browser. Feedbin's upload jobs bake "https://<this host>/..."
# into the URLs they save, with no port - so this must be a hostname
# reachable over HTTPS on 443, not the internal "minio:9000". Add a public
# hostname on the Cloudflare Tunnel (e.g. files.example.com -> http://minio:9000,
# same way as FEEDBIN_HOST below) then point this at it. Leave unset and
# images/favicons will be broken (README has details).
AWS_S3_ENDPOINT=https://files.example.com

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
# (required) Token from Zero Trust → Networks → Tunnels → your tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Image proxy (go-camo) ───────────────────────────────────────────────────
# Optional but recommended. Public URL for the image proxy, routed through
# the same tunnel (e.g. https://camo.example.com → camo:8080).
# Must include the scheme (https://) - Feedbin's CamoFilter concatenates
# this straight into <img src> with no scheme check, so a bare hostname
# produces a path-relative URL the browser resolves against the current
# page (e.g. https://feedbin.example.com/camo.example.com/...) instead of
# an absolute one.
# Leave CAMO_HOST empty to disable image proxying.
CAMO_HOST=https://camo.example.com
# Generate with: openssl rand -hex 32
CAMO_KEY=

# ── Full-content extraction (extract) ───────────────────────────────────────
# Shared secret between Feedbin and the extract service (internal only).
EXTRACT_USER=feedbin
# Generate with: openssl rand -hex 32
EXTRACT_SECRET=

# ── Versions ────────────────────────────────────────────────────────────────
# Git refs to build from: HEAD (default branch), a commit SHA, tag, or branch.
# Pin to a commit SHA for reproducible builds.
FEEDBIN_REF=HEAD
EXTRACT_REF=HEAD
