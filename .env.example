# Copy to .env and fill in. Everything marked (required) must be set.

# ── Identity ────────────────────────────────────────────────────────────────
# (required) Public hostname you'll serve Feedbin from via Cloudflare Tunnel.
# No scheme, no trailing slash.
FEEDBIN_HOST=feedbin.example.com

# ── Secrets ─────────────────────────────────────────────────────────────────
# (required) Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# (required) Postgres password for the "feedbin" database user.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# (required) MinIO (S3-compatible storage) credentials.
MINIO_ROOT_USER=feedbin
# Generate with: openssl rand -hex 24
MINIO_ROOT_PASSWORD=

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
# (required) Token from Zero Trust → Networks → Tunnels → your tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Image proxy (go-camo) ───────────────────────────────────────────────────
# Optional but recommended. Public hostname for the image proxy, routed
# through the same tunnel (e.g. camo.example.com → camo:8080).
# Leave CAMO_HOST empty to disable image proxying.
CAMO_HOST=camo.example.com
# Generate with: openssl rand -hex 32
CAMO_KEY=

# ── Full-content extraction (extract) ───────────────────────────────────────
# Shared secret between Feedbin and the extract service (internal only).
EXTRACT_USER=feedbin
# Generate with: openssl rand -hex 32
EXTRACT_SECRET=

# ── Versions ────────────────────────────────────────────────────────────────
# Git refs to build from: HEAD (default branch), a commit SHA, tag, or branch.
# Pin to a commit SHA for reproducible builds.
FEEDBIN_REF=HEAD
EXTRACT_REF=HEAD
